\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Primary model, one full-parameter recipe, matched data pool, budgets, and seeds. S1--S4 are the unsafe-state suites of Section~\ref {sec:state-suites}; S2--S4 are never used for training or mining. Denominators differ by metric (Section~\ref {sec:metrics}; S4 uses a \(250\)-state subsample at a \(256\)-query budget), so attack success and recovery are \emph  {not} complementary. Base is untrained and evaluated alongside each seeded run, so its SD reflects evaluation-time sampling; it is excluded from the per-column comparison, and \textbf  {bold} marks the best value among the defended methods. External rows reproduce, in order, \citet  {qi2024safety}, \citet  {zhang2024backtracking}, \citet  {zou2024circuit}, \citet  {zhao2025door} (both forms), and \citet  {vega2025presto}. Means over three seeds with seed SD; prompt-clustered intervals are in Appendix~\ref {app:confidence-intervals} and the second model family in Appendix~\ref {app:second-model}.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:main-results}{{1}{8}{Primary model, one full-parameter recipe, matched data pool, budgets, and seeds. S1--S4 are the unsafe-state suites of Section~\ref {sec:state-suites}; S2--S4 are never used for training or mining. Denominators differ by metric (Section~\ref {sec:metrics}; S4 uses a \(250\)-state subsample at a \(256\)-query budget), so attack success and recovery are \emph {not} complementary. Base is untrained and evaluated alongside each seeded run, so its SD reflects evaluation-time sampling; it is excluded from the per-column comparison, and \textbf {bold} marks the best value among the defended methods. External rows reproduce, in order, \citet {qi2024safety}, \citet {zhang2024backtracking}, \citet {zou2024circuit}, \citet {zhao2025door} (both forms), and \citet {vega2025presto}. Means over three seeds with seed SD; prompt-clustered intervals are in Appendix~\ref {app:confidence-intervals} and the second model family in Appendix~\ref {app:second-model}}{table.caption.11}{}}
\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Conditioning context \(\times \) objective at matched prompts, branch texts, scored tokens, steps, seeds, and anchor terms at identical weights. Middle ASR{} is suite S1. Root-conditioned cells reuse the identical branch texts with the reached state removed; the reached-state DPO and SFT cells are the Uniform Same-State DPO and Recovery SFT rows of Table~\ref {tab:main-results}. The last row scores the shared prefix instead of masking it.}}{8}{table.caption.12}\protected@file@percent }
\newlabel{tab:factorial}{{2}{8}{Conditioning context \(\times \) objective at matched prompts, branch texts, scored tokens, steps, seeds, and anchor terms at identical weights. Middle \asr {} is suite S1. Root-conditioned cells reuse the identical branch texts with the reached state removed; the reached-state DPO and SFT cells are the Uniform Same-State DPO and Recovery SFT rows of Table~\ref {tab:main-results}. The last row scores the shared prefix instead of masking it}{table.caption.12}{}}
